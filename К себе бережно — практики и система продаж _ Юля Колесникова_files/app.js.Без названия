(()=>{const c=window.SITE_CONFIG;const date=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Moscow',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());let tier=c.mode==='manual'?c.manualTier:Math.max(0,c.schedule.reduce((a,x,i)=>date>=x[0]?i:a,0));tier=Math.max(0,Math.min(c.schedule.length-1,tier));const amount=c.schedule[tier][1],money=n=>new Intl.NumberFormat('ru-RU').format(n)+' <span class="currency">₽</span>';document.querySelectorAll('.standard').forEach(e=>e.innerHTML=money(amount));document.querySelectorAll('.feedback').forEach(e=>e.innerHTML=money(amount+c.feedbackExtra));document.querySelectorAll('.price-status').forEach(e=>e.textContent=date<'2026-11-02'?'Цена открытия продаж только 2 ноября': 'Актуальная стоимость участия');document.querySelectorAll('.gift-note').forEach(e=>e.hidden=date>=c.bonusEnd);if(date>=c.bonusEnd){document.querySelector('.bonus .gift-heading').textContent='ТРЕНАЖЁР РАСПОЗНАВАНИЯ СКРЫТОГО ДАВЛЕНИЯ';document.querySelector('.bonus').querySelectorAll('p').forEach(e=>{if(/подарок/.test(e.textContent))e.hidden=true;});}document.querySelectorAll('[data-installment]').forEach(e=>{const price=amount+(e.dataset.installment==='feedback'?c.feedbackExtra:0);e.innerHTML='При оплате в рассрочку без % — от '+new Intl.NumberFormat('ru-RU').format(Math.floor(price/12))+' <span class="currency">₽</span> /мес'});document.querySelectorAll('a[data-pay]').forEach(a=>{a.href=a.dataset.pay==='foreign'?c.PAYMENT_URL_FOREIGN:(a.dataset.pay==='feedback'?c.PAYMENT_URL_FEEDBACK:c.PAYMENT_URL_STANDARD)});})();
